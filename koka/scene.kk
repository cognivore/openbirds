// koka/scene.kk — UI scene state for openbirds.
//
// The brain owns "what's on screen" — including UI widgets and the
// app's lifecycle. The scene is one of:
//
//   Idle             — black background with the close button. NO
//                      GIF rendered. Lucile is the goodbye, not a
//                      mood; we only play her once, and only when
//                      the user has decided they're leaving.
//   Exiting(exit-at) — button hidden; GIF playing through one full
//                      cycle. `exit-at` is the absolute time (same
//                      monotonic clock the renderer uses) at which
//                      we transition to Done.
//   Done             — bridge polls true on `should-exit`, Swift
//                      calls `exit(0)`.
//
// Why a separate module: keeps the close-button + lifecycle logic
// out of the renderer (which only asks "is the button visible?
// is the GIF playing?") and out of the GIF loader (which is purely
// about pixel data).

module scene

import std/num/float64

// The tamagotchi MVP extends the original two-state scene
// (Idle / Exiting / Done) with two new states that bookend the
// home experience:
//
//   Loading                      — boot: no tamagotchi has loaded
//                                  yet. The renderer paints solid
//                                  brand neutral; taps are ignored.
//                                  The bridge transitions us OUT
//                                  of Loading either by calling
//                                  `begin-celebration` once at
//                                  least one slot is loaded, or
//                                  (defensive) by `force-home` if
//                                  the celebration was skipped.
//
//   Celebrating(start, exit-at)  — fullscreen happy animation of
//                                  the active tamagotchi. The
//                                  renderer plays the chosen GIF
//                                  at the highest happiness loop
//                                  (speed * 1.75, max bounce). The
//                                  scene auto-advances to Idle at
//                                  `exit-at`.
//
//   Idle                         — home composition: arena +
//                                  three task cards (= "Home" in
//                                  layout vocabulary). Idle stays
//                                  the constructor name to keep
//                                  the FFI-level scene-cell shape
//                                  backwards compatible with the
//                                  existing bridge wiring.
//
//   Exiting / Done — legacy goodbye path kept for the close-
//                    button test surface; not exercised by the
//                    home screen yet.
pub type scene-state
  Loading
  Celebrating(start-at-s : float64, exit-at-s : float64)
  Idle
  Exiting (exit-at-s : float64)
  Done

pub alias scene-cell = ref<global, scene-state>

pub fun new-scene-cell() : alloc<global> scene-cell
  ref(Loading)

// Bridge transitions Loading → Celebrating once assets are ready.
// Idempotent: a second call resets the deadline (= replays the
// celebration). Used on app open and, eventually, on the first
// foreground after 6 am of a new day.
pub fun begin-celebration(s : scene-cell, now : float64, duration : float64)
        : <read<global>, write<global>> ()
  s := Celebrating(now, now + duration)

// Defensive transition for tests + future "user dismissed the
// celebration" gesture. Idempotent.
pub fun force-home(s : scene-cell) : <read<global>, write<global>> ()
  s := Idle

// Per-frame clock advance. Handles the two automatic transitions:
// Celebrating → Idle when the cheer deadline elapses, Exiting →
// Done when the goodbye deadline elapses. Called BEFORE every
// `should-exit` and BEFORE every render so the scene chooses the
// right branch on the same tick the deadline hits.
pub fun tick-scene(s : scene-cell, now : float64)
        : <read<global>, write<global>> ()
  match !s
    Loading -> ()
    Celebrating(_, deadline) ->
      if now >= deadline then s := Idle
      else ()
    Idle -> ()
    Exiting(deadline) ->
      if now >= deadline then s := Done
      else ()
    Done -> ()

// Diagnostic for the bridge / log lines — which constructor is
// active? Returned as a small int to avoid string allocation
// per call.
//   0 = Loading
//   1 = Celebrating
//   2 = Idle (= Home)
//   3 = Exiting
//   4 = Done
pub fun scene-tag(s : scene-cell) : <read<global>> int
  match !s
    Loading -> 0
    Celebrating(_, _) -> 1
    Idle -> 2
    Exiting(_) -> 3
    Done -> 4

// Note: the `is-Loading` / `is-Celebrating` / `is-Idle` / `is-Exiting`
// / `is-Done` predicates are auto-generated by Koka from the type
// declaration above (one per constructor). No need to declare
// hand-rolled `is-loading` etc. — and doing so would collide with
// the generated names. The renderer uses `match !sc` directly,
// which is the only consumer.

// Button hit-testing. Coordinates are in OUTPUT (post-scaling)
// pixels — same coordinate system Swift sees. `w` and `h` are the
// current framebuffer dimensions so the button stays anchored
// regardless of resolution. The button occupies the bottom 15% of
// the screen, full width.
pub fun button-rect(w : int, h : int) : (int, int, int, int)
  val bx0 = 0
  val by0 = (h * 85) / 100
  val bx1 = w - 1
  val by1 = h - 1
  (bx0, by0, bx1, by1)

// Once the user taps inside any close-triggering rect, transition
// Idle → Exiting. `exit-at-s` is `now + gif-duration-s` — the bridge
// computes it from the loaded GIF's total-cs and passes the
// absolute deadline here so scene.kk doesn't need to know about
// runtime.kk. Subsequent taps during the goodbye animation are
// ignored.
//
// The tap is `(content-x, content-y)` — the bridge has already
// added scroll-y to the viewport-y so this scene-level check is
// in CONTENT coordinates (the same coords the page composer
// places its [X] and CLOSE rects at).
pub fun handle-tap-on-rects(s : scene-cell,
                            content-x : int, content-y : int,
                            x-rect : (int, int, int, int),
                            close-rect : (int, int, int, int),
                            exit-at-s : float64)
        : <read<global>, write<global>> ()
  if rect-contains(x-rect, content-x, content-y) ||
     rect-contains(close-rect, content-x, content-y) then
    match !s
      Idle -> s := Exiting(exit-at-s)
      _    -> ()
  else ()

fun rect-contains(r : (int, int, int, int), x : int, y : int) : bool
  val (x0, y0, x1, y1) = r
  x >= x0 && x < x1 && y >= y0 && y < y1

// Backwards-compat shim — old callers (a vestigial test path) hit
// the bottom 15% bar regardless of layout. Will be removed once
// every caller is on `handle-tap-on-rects`.
pub fun handle-tap(s : scene-cell,
                   x : int, y : int, w : int, h : int,
                   exit-at-s : float64)
        : <read<global>, write<global>> ()
  val (bx0, by0, bx1, by1) = button-rect(w, h)
  if x >= bx0 && x <= bx1 && y >= by0 && y <= by1 then
    match !s
      Idle -> s := Exiting(exit-at-s)
      _    -> ()
  else ()

// Polled by the bridge every frame. Advances the state machine
// when any time-based deadline is reached; returns whether the
// app should exit *right now*. Loading / Celebrating / Idle never
// exit; Exiting checks the deadline; Done always returns True.
pub fun should-exit(s : scene-cell, now : float64)
        : <read<global>, write<global>> bool
  tick-scene(s, now)
  match !s
    Done -> True
    _    -> False

// Renderer asks this to decide whether to draw the close-button
// overlay. With the home screen the button is gone for now (the
// home renders the card panel instead); kept for backwards
// compat with the legacy tap path.
pub fun button-visible(s : scene-cell) : <read<global>> bool
  match !s
    Idle -> False
    _    -> False

// Renderer asks this to decide whether to take over the screen
// with the active tamagotchi animation: True during Celebrating
// (cheerful intro / new-day banner) and during the legacy
// Exiting goodbye. Home and Loading return False — they want the
// composed layout / placeholder.
pub fun show-gif(s : scene-cell) : <read<global>> bool
  match !s
    Celebrating(_, _) -> True
    Exiting(_)        -> True
    _                 -> False
